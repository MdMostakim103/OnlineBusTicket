<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@BusOwnerHomePage.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BusOwnerHomePage">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" styleClass="header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Label styleClass="header-title" text="Bus Owner Dashboard" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets bottom="10.0" left="20.0" right="10.0" top="10.0"/>
            </HBox.margin>
        </Label>

        <!-- Notification Bell Icon -->
        <Button fx:id="notification" onAction="#handleNotification" prefWidth="40" styleClass="icon-button" text="🔔" />

        <Button fx:id="reportbutton" mnemonicParsing="false" onAction="#ReportHandling" prefHeight="31.0" prefWidth="84.0" text="Report Issue" />

        <Button fx:id="logoutButton" onAction="#handleLogout" prefHeight="7.0" prefWidth="65.0" styleClass="danger-button" text="Logout">
            <HBox.margin>
                <Insets bottom="10.0" left="10.0" right="20.0" top="10.0" />
            </HBox.margin>
        </Button>
      <Button fx:id="quitId" mnemonicParsing="false" onAction="#handleQuitButton" prefHeight="31.0" prefWidth="49.0" text="Quit" />
    </HBox>

    <!-- Main Content Area -->
    <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="60.0">

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="updateRouteButton" maxWidth="Infinity" onAction="#handleUpdateRoute" styleClass="primary-button" text="Update Route" HBox.hgrow="ALWAYS" />
            <Button fx:id="updateInfoButton" maxWidth="Infinity" onAction="#handleUpdateInfo" styleClass="primary-button" text="Update Info" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Today's Passenger List Section -->
        <VBox spacing="8.0" styleClass="section" VBox.vgrow="ALWAYS">
            <Label styleClass="section-title" text="Today's Passenger List" />
            <TableView fx:id="todaysPassengerTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="emailIdColumn" prefWidth="215" text="Passenger Email" />
                    <TableColumn fx:id="routeColumn" prefWidth="175" text="Route" />
                    <TableColumn fx:id="seatNumberColumn" prefWidth="125" text="Seat" />
                    <TableColumn fx:id="fareColumn" prefWidth="75" text="Fare (BDT)" />
                    <TableColumn fx:id="bookingDateColumn" prefWidth="142.0" text="Date" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
