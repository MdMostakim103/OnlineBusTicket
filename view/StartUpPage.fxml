<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.StartUpPage"
            prefHeight="600.0" prefWidth="800.0"
            styleClass="root-pane">

    <Label fx:id="welcomeLabel" layoutX="0" layoutY="140" prefWidth="800" prefHeight="140"
           styleClass="welcome-label"
           text="Welcome to Transport System🚌"
           alignment="CENTER" wrapText="true"/>

    <ImageView fx:id="startUpImage" fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true" />

    <Button fx:id="adminButton" layoutX="124.0" layoutY="533.0" mnemonicParsing="false" onAction="#admin" text="Admin"
            styleClass="main-button"/>

    <Button fx:id="vehicleButton" layoutX="307.0" layoutY="533.0" mnemonicParsing="false" onAction="#vehicleOwner"
            prefHeight="25.0" prefWidth="127.0" text="Vehicle Owner" styleClass="main-button"/>

    <Button fx:id="passengerButton" layoutX="547.0" layoutY="533.0" mnemonicParsing="false" onAction="#passenger"
            text="Passenger" styleClass="main-button"/>

</AnchorPane>