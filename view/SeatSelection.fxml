<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SeatSelection">
    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <Label fx:id="seatInfoLabel" style="-fx-font-size: 16px;" text="Selected Seats: 0 | Total Fare: 0 BDT" />

        <GridPane fx:id="seatGrid" hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" /> <!-- aisle -->
                <ColumnConstraints percentWidth="20" />
                <ColumnConstraints percentWidth="20" />
            </columnConstraints>
        </GridPane>

        <HBox alignment="CENTER" spacing="30">
            <Button fx:id="confirmButton" onAction="#handleConfirm" prefWidth="120" text="Confirm" />
            <Button fx:id="backButton" onAction="#backToPrevScene" prefWidth="120" text="Back" />
        </HBox>
    </VBox>

</AnchorPane>
